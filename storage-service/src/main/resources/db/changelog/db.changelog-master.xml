<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="car_parts_creation" author="20moonlight01">
        <createTable tableName="car_parts">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="removed" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="steering_wheels_creation" author="20moonlight01">
        <createTable tableName="steering_wheels">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="steering_wheels" baseColumnNames="id"
                constraintName="fk_steering_wheels_car_parts"
                referencedTableName="car_parts" referencedColumnNames="id"
        />
    </changeSet>

    <changeSet id="wheels_creation" author="20moonlight01">
        <createTable tableName="wheels">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="wheels" baseColumnNames="id"
                constraintName="fk_wheels_car_parts"
                referencedTableName="car_parts" referencedColumnNames="id"
        />
    </changeSet>

    <changeSet id="interiors_creation" author="20moonlight01">
        <createTable tableName="interiors">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="interiors" baseColumnNames="id"
                constraintName="fk_interiors_car_parts"
                referencedTableName="car_parts" referencedColumnNames="id"
        />
    </changeSet>

    <changeSet id="transmissions_creation" author="20moonlight01">
        <createTable tableName="transmissions">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
