    <changeSet id="cars_creation" author="20moonlight01">
        <createTable tableName="cars">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="model_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="color" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="steering_wheel_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="wheels_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="interior_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="transmission_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="car_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="removed" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="cars" baseColumnNames="model_id"
                constraintName="fk_cars_car_models"
                referencedTableName="car_models" referencedColumnNames="id"
        />
        <addForeignKeyConstraint
                baseTableName="cars" baseColumnNames="steering_wheel_id"
                constraintName="fk_cars_steering_wheels"
                referencedTableName="steering_wheels" referencedColumnNames="id"
        />
        <addForeignKeyConstraint
                baseTableName="cars" baseColumnNames="wheels_id"
                constraintName="fk_cars_wheels"
                referencedTableName="wheels" referencedColumnNames="id"
        />
        <addForeignKeyConstraint
                baseTableName="cars" baseColumnNames="interior_id"
                constraintName="fk_cars_interiors"
                referencedTableName="interiors" referencedColumnNames="id"
        />
        <addForeignKeyConstraint
                baseTableName="cars" baseColumnNames="transmission_id"
                constraintName="fk_cars_transmissions"
                referencedTableName="transmissions" referencedColumnNames="id"
        />
    </changeSet>

